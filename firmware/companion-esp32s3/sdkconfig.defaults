# KOGANE companion defaults (esp32s3, WROOM-1-N16R8)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_EN=y
# Wi-Fi
CONFIG_ESP_WIFI_ENABLED=y
# Larger main task stack for bring-up logging
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# Avoid automatic UART reset while the board's IO0 strap is pulled low.
CONFIG_ESPTOOLPY_BEFORE_NORESET=y

# ---- Console: native USB (USB-Serial-JTAG), not UART0 ----
# The prior module's RXD0 castellation was destroyed. The replacement's UART
# continuity is not yet verified. The prior board flashed and logged over native
# USB on COM11; the replacement is reported as COM13, pending identification.
#
# ESP_CONSOLE_UART_DEFAULT / _UART_CUSTOM / _USB_CDC / _NONE are members of the
# same Kconfig choice as the line below, so selecting USB_SERIAL_JTAG here makes
# UART0 non-primary automatically. They are deliberately NOT written out as
# "is not set" lines: kconfgen parses that form as an explicit n, which fights
# the choice and produces a spurious NOTE at parse time.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# No secondary console: USB-Serial-JTAG is already the primary.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---- Owner of GPIO43/44 (nets ESP32-TX/ESP32-RX -> STM32F722 PA9/PA10) ----
# With the console on USB, GPIO43/44 are no longer needed for logging, so
# handing them to the FC link would NOT cost us the boot log any more. The old
# comment here claimed CONFIG_ESP_CONSOLE_NONE=y was required and that there was
# no fallback log path — that is no longer true.
#
# Keep the FC link reserved while the replacement module, GPIO44 continuity,
# and the bridge firmware are checked separately. A half-open link is worse
# than an inert one. See PINMAP.md and BRINGUP.md.
CONFIG_KGN_PINS_OWNER_CONSOLE=y

# ---- Partition table: custom, 3 MB app ----
# The stock single-app table gives the app 1 MB and the image was already 83%
# full before the camera went in. The module has 16 MB of flash, of which the
# stock table used ~3 MB, so `factory` is now 3 MB and nvs/phy_init keep their
# original offsets and sizes (so nothing in nvs moves). Full rationale, including
# why there are no OTA slots and no storage partition, is in partitions.csv.
#
# PARTITION_TABLE_SINGLE_APP / _SINGLE_APP_LARGE / _TWO_OTA / _TWO_OTA_LARGE are
# members of the same Kconfig choice as the line below, so selecting CUSTOM here
# deselects them automatically — same reasoning as the console block above, they
# are deliberately not written out as "is not set" lines.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
